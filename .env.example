# ============================================================
# 环境变量示例（复制为 .env 并按需填写）
# 注意：禁止把真实 Key 写进本文件或任何提交到仓库的文件
# ============================================================

# 数据库
DB_URL=jdbc:mysql://localhost:3306/friendxxx?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=2

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=friendxxx
RABBITMQ_PASSWORD=123456
RABBITMQ_VIRTUAL_HOST=FZZ

# Elasticsearch
ELASTICSEARCH_URIS=http://localhost:9200

# DeepSeek 官方 API（AI 拟人聊天，唯一模型供应商）
# 必填：无可用默认 Key，必须通过环境变量注入
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_UTILITY_MODEL=deepseek-v4-flash

# 限流开关（生产默认开启；本地无 Redis 时设为 false）
APP_RATE_LIMIT_ENABLED=true

# JWT
JWT_SECRET=change-this-development-secret-at-least-32-bytes
JWT_TTL_SECONDS=2592000
